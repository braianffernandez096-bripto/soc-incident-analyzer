# Copia este archivo como .env y completa solo lo que necesites. Nunca subas .env a GitHub.
# Todas las variables son opcionales: sin ninguna, la app funciona con el informe por reglas.

# Claude (redacción del informe con IA). Opcional.
ANTHROPIC_API_KEY=
# Modelo a usar (por defecto claude-sonnet-5-5). Opcional.
# ANTHROPIC_MODEL=claude-sonnet-5-5

# OpenAI (alternativa a Claude, con tu propia clave). Opcional. Se elige en las pestañas Informe e Incidentes.
# OPENAI_API_KEY=
# Los nombres de modelo cambian seguido: puedes fijar el que prefieras (por defecto gpt-5.4-mini).
# OPENAI_MODEL=gpt-5.4-mini

# Gemini de Google (alternativa a Claude, con tu propia clave). Opcional.
# GEMINI_API_KEY=
# GEMINI_MODEL=gemini-3.8-flash

# IA local con Ollama (alternativa a Claude; los datos no salen de tu equipo si Ollama está en él). Opcional.
# Se elige en la pestaña Informe; el modelo debe estar instalado (ollama pull <modelo>).
# OLLAMA_HOST=http://127.0.0.1:11434
# Contexto en tokens (Ollama usa 2.048-4.096 por defecto y recortaría la evidencia):
# OLLAMA_NUM_CTX=16384
# Tiempo máximo de espera por consulta, en segundos (por defecto 3600). Un equipo sin GPU puede tardar mucho en un incidente grande:
# OLLAMA_TIMEOUT=3600

# Reputación de IP y dominios públicos (cuentas gratuitas). Opcionales.
# VirusTotal: https://www.virustotal.com  ->  perfil  ->  API key
VT_API_KEY=
# AbuseIPDB: https://www.abuseipdb.com  ->  Account  ->  API
ABUSEIPDB_API_KEY=
# Ajustes de la consulta de reputación (valores por defecto entre paréntesis). Casi nunca hace falta tocarlos.
# Máximo de indicadores por consulta (25):
# INTEL_MAX_INDICATORS=25
# Segundos entre consultas a VirusTotal (15.5, para respetar las 4 por minuto del plan gratuito; bájalo solo con un plan de pago):
# INTEL_VT_INTERVAL=15.5
# Segundos entre consultas a AbuseIPDB (0.3):
# INTEL_ABUSE_INTERVAL=0.3

# Clave de acceso a la app (una sola clave compartida, no hay usuarios). Opcional.
# Actívala si vas a exponer la app en una red: sin ella cualquiera que llegue al puerto puede usarla.
# Mínimo 16 caracteres. Genera una con:  openssl rand -hex 24
# Úsala siempre detrás de HTTPS (proxy inverso), si no viaja sin cifrar.
APP_ACCESS_TOKEN=

# Captcha local para las subidas de archivos (logs y .eml). Opcional, apagado por defecto. No usa servicios de terceros.
# Actívalo si vas a publicar la app en internet. CAPTCHA_TYPE: imagenes, rompecabezas o aleatorio (por defecto).
# CAPTCHA=on
# CAPTCHA_TYPE=aleatorio

# Consultas DNS (Evaluar dominio y Dominios parecidos): usan DNS sobre HTTPS a Cloudflare/Google y solo envían nombres de dominio.
# DNS_LOOKUPS=off las desactiva (por ejemplo en una red sin salida a Internet).
# DNS_LOOKUPS=on

# Publica la documentación interactiva de la API en /docs (1 = sí). Por defecto desactivada.
# ENABLE_DOCS=
# Nivel de registro: DEBUG, INFO, WARNING o ERROR (por defecto INFO).
# LOG_LEVEL=INFO

# --- Modo Wazuh en vivo (opcional, apagado por defecto). Guía: docs/WAZUH.md ---
# WAZUH_INGEST=on
# WAZUH_INGEST_TOKEN=            # 16+ caracteres; la misma clave va en <api_key> de la integración de Wazuh
# WAZUH_ANALYZE_SECONDS=60       # cada cuánto se analizan las alertas nuevas
# WAZUH_WINDOW_HOURS=24          # cuánto tiempo se conservan en memoria (máx. 168)
# WAZUH_MAX_ROWS=5000            # máximo de alertas en la ventana (máx. 20000)
# WAZUH_DIGEST_MINUTES=60        # resumen de lo medio y bajo
# Avisos a Telegram (opcional). El mensaje no lleva usuarios, IPs ni logs.
# TELEGRAM_BOT_TOKEN=
# TELEGRAM_CHAT_ID=
# APP_BASE_URL=http://127.0.0.1:8000
# TELEGRAM_INCLUDE_HOST=1        # agrega el nombre del equipo al aviso (por defecto no)
# TELEGRAM_DETAIL=full           # suma título, equipo, cuentas e IPs al aviso (por defecto no: Telegram no cifra de extremo a extremo)

# --- Contexto opcional (apagado por defecto). Guía: docs/CONTEXTO.md ---
# CISA KEV + EPSS: se descargan los archivos públicos completos y el cruce se hace en local (ningún CVE tuyo sale de tu red).
# CONTEXT_ENABLED=on
# CONTEXT_DIR=/tmp/context        # dónde se guardan los archivos descargados
# CONTEXT_REFRESH_HOURS=24        # cada cuánto se vuelven a descargar
# Tu propia instancia de MISP (la clave de API va solo aquí, nunca en el chat ni en el repositorio):
# MISP_URL=https://192.168.64.20
# MISP_KEY=
# MISP_VERIFY=0                   # solo si el certificado es autofirmado (laboratorio)
# MISP_ONLY_IDS=1                 # solo atributos marcados «to_ids» (por defecto sí)
# MISP_INCLUDE_PRIVATE=1          # consultar también IP privadas (por defecto no)
# MISP_CACHE_SECONDS=600          # cuánto se recuerda una respuesta de MISP

# --- Feed JSON propio de indicadores (apagado por defecto). Guía: docs/FEED.md ---
# FEED_PATH=/feed/indicadores.json   # archivo dentro de ./feed (se monta solo lectura); o bien FEED_URL=https://...
# FEED_TTL_DAYS=30                   # los indicadores vencen a los N días de su fecha (0 = no vencen por tiempo)
# FEED_REFRESH_HOURS=6               # cada cuánto se vuelve a descargar si usas FEED_URL

# --- Contexto desde el Indexer de Wazuh (apagado por defecto). Guía: docs/WAZUH.md ---
# WAZUH_INDEXER_URL=https://single-node-wazuh.indexer-1:9200   # dentro de la red de Wazuh (docker-compose.wazuh.yml)
# WAZUH_INDEXER_USER=usuario-de-solo-lectura
# WAZUH_INDEXER_PASSWORD=             # solo aquí, nunca en el chat ni en el repositorio
# WAZUH_INDEXER_VERIFY=0              # solo si el certificado es autofirmado (laboratorio)
# WAZUH_INDEXER_WINDOW_MIN=5          # minutos antes y después del hallazgo
# WAZUH_INDEXER_MAX=100               # registros máximos por consulta
# WAZUH_INDEXER_ARCHIVES=             # off para no mirar el índice de eventos crudos (wazuh-archives)
# WAZUH_INDEXER_RAW_WINDOW_SEC=90     # segundos antes y después para los eventos crudos
# WAZUH_INDEXER_RAW_MAX=50            # eventos crudos máximos por consulta
