# Copia este archivo como .env y completa solo lo que necesites. Nunca subas .env a GitHub.
# Todas las variables son opcionales: sin ninguna, la app funciona con el informe por reglas.

# Claude (redacción del informe con IA). Opcional.
ANTHROPIC_API_KEY=
# Modelo a usar (por defecto claude-sonnet-5-5). Opcional.
# ANTHROPIC_MODEL=claude-sonnet-5-5

# IA local con Ollama (alternativa a Claude; los datos no salen de tu equipo si Ollama está en él). Opcional.
# Se elige en la pestaña Informe; el modelo debe estar instalado (ollama pull <modelo>).
# OLLAMA_HOST=http://127.0.0.1:11434
# Contexto en tokens (Ollama usa 2.048-4.096 por defecto y recortaría la evidencia):
# OLLAMA_NUM_CTX=16384
# Tiempo máximo de espera por consulta, en segundos (por defecto 3600). Un equipo sin GPU puede tardar mucho en un incidente grande:
# OLLAMA_TIMEOUT=3600

# Reputación de IP y dominios públicos (cuentas gratuitas). Opcionales.
# VirusTotal: https://www.virustotal.com  ->  perfil  ->  API key
VT_API_KEY=
# AbuseIPDB: https://www.abuseipdb.com  ->  Account  ->  API
ABUSEIPDB_API_KEY=
# Ajustes de la consulta de reputación (valores por defecto entre paréntesis). Casi nunca hace falta tocarlos.
# Máximo de indicadores por consulta (25):
# INTEL_MAX_INDICATORS=25
# Segundos entre consultas a VirusTotal (15.5, para respetar las 4 por minuto del plan gratuito; bájalo solo con un plan de pago):
# INTEL_VT_INTERVAL=15.5
# Segundos entre consultas a AbuseIPDB (0.3):
# INTEL_ABUSE_INTERVAL=0.3

# Clave de acceso a la app (una sola clave compartida, no hay usuarios). Opcional.
# Actívala si vas a exponer la app en una red: sin ella cualquiera que llegue al puerto puede usarla.
# Mínimo 16 caracteres. Genera una con:  openssl rand -hex 24
# Úsala siempre detrás de HTTPS (proxy inverso), si no viaja sin cifrar.
APP_ACCESS_TOKEN=

# Captcha local para las subidas de archivos (logs y .eml). Opcional, apagado por defecto. No usa servicios de terceros.
# Actívalo si vas a publicar la app en internet. CAPTCHA_TYPE: imagenes, rompecabezas o aleatorio (por defecto).
# CAPTCHA=on
# CAPTCHA_TYPE=aleatorio

# Consultas DNS (Evaluar dominio y Dominios parecidos): usan DNS sobre HTTPS a Cloudflare/Google y solo envían nombres de dominio.
# DNS_LOOKUPS=off las desactiva (por ejemplo en una red sin salida a Internet).
# DNS_LOOKUPS=on

# Publica la documentación interactiva de la API en /docs (1 = sí). Por defecto desactivada.
# ENABLE_DOCS=
# Nivel de registro: DEBUG, INFO, WARNING o ERROR (por defecto INFO).
# LOG_LEVEL=INFO
