#!/bin/sh
# Lanzador de la integración (Wazuh ejecuta los scripts «custom-*» con 3 argumentos: archivo de la alerta, clave y URL).
# Usa el Python que ya trae Wazuh, así no hay que instalar nada en el manager.
WAZUH_PATH="$(cd "$(dirname "$0")/.." && pwd)"
exec "${WAZUH_PATH}/framework/python/bin/python3" "${WAZUH_PATH}/integrations/custom-soc-analyzer.py" "$@"
